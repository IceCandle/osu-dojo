# Copy this file to `.env` and fill in values.
# Never commit your real `.env`.

# ==================================
# DATABASE
# ==================================
# Local dev (matches `docker-compose.yml` defaults)
DATABASE_URL="postgresql://postgres:osudojo_dev_password@localhost:5432/osudojo"

# ==================================
# REDIS
# ==================================
REDIS_URL="redis://localhost:6379"

# ==================================
# OSU! IRC BOT CREDENTIALS
# ==================================
# Get IRC credentials from: https://osu.ppy.sh/p/irc
OSU_IRC_USERNAME="your_osu_username"
OSU_IRC_PASSWORD="your_irc_password"

# Optional legacy key (some code paths reference it)
OSU_API_KEY=""

# ==================================
# OSU! API V2 (OAuth)
# ==================================
# Create OAuth application at: https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=""
OSU_CLIENT_SECRET=""
OSU_REDIRECT_URI="http://localhost:3000/api/auth/callback/osu"

# ==================================
# NEXTAUTH.JS
# ==================================
# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ==================================
# NEXT.JS
# ==================================
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
