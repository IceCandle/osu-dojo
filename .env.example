# osu! IRC credentials (get from https://osu.ppy.sh/home/account/edit#legacy-api)
# Use your personal account for development
OSU_IRC_USERNAME=
OSU_IRC_PASSWORD=
DATABASE_URL=file:./dojo.db

# Public site origin used for OAuth callbacks
DOJO_SITE_URL=http://localhost:3000
# Local loopback-only dummy login; never enable in a public environment
# DOJO_E2E_AUTH=1
# Session signing secret: openssl rand -base64 48
SESSION_SECRET=
# osu! OAuth application credentials (required by the live bot and real login)
# https://osu.ppy.sh/home/account/edit#oauth
OSU_OAUTH_CLIENT_ID=
OSU_OAUTH_CLIENT_SECRET=
